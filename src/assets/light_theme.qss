/* Light Theme QSS */

QMainWindow::separator {
  background: transparent;
  width: 6px;
  height: 6px;
}
QMainWindow::separator:hover {
  background: #0078d7;
}
QSplitter::handle {
  background: transparent;
  width: 6px;
  height: 6px;
}
QSplitter::handle:hover {
  background: #0078d7;
}

/* Start/Stop measurement buttons are styled per-widget in MainWindow so the
   accent colors apply in native styling mode too (see applyControlButtonStyles). */

QGroupBox {
  border: 1px solid #d0d4d9;
  border-radius: 4px;
  margin-top: 8px;
  padding-top: 6px;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 8px;
  padding: 0 4px;
}

QToolTip {
  color: #1f2328;
  background-color: #ffffff;
  border: 1px solid #8c959f;
  padding: 3px 6px;
}
