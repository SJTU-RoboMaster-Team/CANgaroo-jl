/*
 * CANgaroo dark theme — kept as the legacy dark scheme for P1.
 * Structure mirrors light_theme.qss so both themes stay easy to maintain.
 */

QWidget {
    color: #DCDCDC;
}

QMainWindow,
QDialog {
    background-color: #2D2D30;
}

QMainWindow::separator {
    background: #3E3E42;
    width: 6px;
    height: 6px;
}
QMainWindow::separator:hover {
    background: #007ACC;
}

QSplitter::handle {
    background: #343438;
}
QSplitter::handle:hover {
    background: #007ACC;
}
QSplitter::handle:horizontal {
    width: 6px;
}
QSplitter::handle:vertical {
    height: 6px;
}

QMenuBar {
    background-color: #2D2D30;
    color: #DCDCDC;
    border-bottom: 1px solid #3F3F46;
    padding: 1px 4px;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background: #3E3E42;
}
QMenuBar::item:pressed {
    background: #4E4E52;
}

QMenu {
    background-color: #1B1B1C;
    color: #F1F1F1;
    border: 1px solid #434346;
    padding: 6px;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #333334;
}
QMenu::item:disabled {
    color: #656565;
}
QMenu::separator {
    height: 1px;
    background: #434346;
    margin: 6px 8px;
}

QToolBar {
    background: #2D2D30;
    border: none;
    border-bottom: 1px solid #3F3F46;
    spacing: 6px;
    padding: 4px 8px;
}
QToolBar::separator {
    width: 1px;
    background: #3F3F46;
    margin: 6px 6px;
}

QStatusBar {
    background: #2D2D30;
    color: #A0A0A0;
    border-top: 1px solid #3F3F46;
}
QStatusBar QLabel {
    color: #A0A0A0;
    padding: 0 6px;
}
QStatusBar::item {
    border: none;
}

QTabWidget::pane {
    border: 1px solid #3F3F46;
    background: #1E1E1E;
    top: -1px;
}
QTabWidget::tab-bar {
    alignment: left;
}
QTabBar {
    background: transparent;
}
QTabBar::tab {
    background: transparent;
    color: #A0A0A0;
    padding: 6px 14px;
    margin-right: 2px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover {
    color: #DCDCDC;
    background: #3E3E42;
    border-radius: 4px 4px 0 0;
}
QTabBar::tab:selected {
    color: #F1F1F1;
    background: #2D2D30;
    border-bottom: 2px solid #007ACC;
}
QTabBar::tab:disabled {
    color: #656565;
}
QTabBar::close-button {
    image: url(:/assets/icons/tab-close-dark.svg);
    subcontrol-position: right;
    margin: 2px;
}
QTabBar::close-button:hover {
    image: url(:/assets/icons/tab-close-dark-hover.svg);
}

QDockWidget {
    color: #DCDCDC;
}
QDockWidget::title {
    background: #252526;
    color: #DCDCDC;
    padding: 5px 10px;
    border: 1px solid #3F3F46;
    border-bottom: none;
}

QPushButton {
    background: #3E3E42;
    color: #DCDCDC;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 5px 12px;
    min-height: 16px;
}
QPushButton:hover {
    background: #4E4E52;
}
QPushButton:pressed {
    background: #007ACC;
}
QPushButton:focus {
    border: 1px solid #60A5FA;
    outline: none;
}
QPushButton:disabled {
    background: #2D2D30;
    color: #656565;
    border-color: #3E3E42;
}
QPushButton:default {
    border-color: #007ACC;
}

QPushButton[uiRole="primary"],
QPushButton#btnStartMeasurement {
    background: #007ACC;
    color: #FFFFFF;
    border: 1px solid #007ACC;
    font-weight: 600;
}
QPushButton[uiRole="primary"]:hover,
QPushButton#btnStartMeasurement:hover {
    background: #1A8AD4;
    border-color: #1A8AD4;
}
QPushButton[uiRole="primary"]:pressed,
QPushButton#btnStartMeasurement:pressed {
    background: #005A99;
    border-color: #005A99;
}
QPushButton[uiRole="primary"]:disabled,
QPushButton#btnStartMeasurement:disabled {
    background: #1F3A4D;
    border-color: #1F3A4D;
    color: #7FA8C4;
}

QPushButton[uiRole="danger"] {
    background: #3E3E42;
    color: #F87171;
    border: 1px solid #7A3B3B;
}
QPushButton[uiRole="danger"]:hover {
    background: #4A3434;
}
QPushButton[uiRole="danger"]:pressed {
    background: #5A3A3A;
}
QPushButton[uiRole="danger"]:disabled {
    color: #8A6A6A;
    border-color: #4A3A3A;
}

QToolButton {
    background: transparent;
    color: #DCDCDC;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
}
QToolButton:hover {
    background: #3E3E42;
}
QToolButton:pressed {
    background: #4E4E52;
}
QToolButton:checked {
    background: #007ACC;
    color: #FFFFFF;
}
QToolButton:checked:hover {
    background: #1A8AD4;
}
QToolButton:disabled {
    color: #656565;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QPlainTextEdit,
QTextEdit {
    background: #333337;
    color: #F1F1F1;
    border: 1px solid #434346;
    border-radius: 4px;
    padding: 3px 6px;
    selection-background-color: #264F78;
    selection-color: #FFFFFF;
}
QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #555555;
}
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border: 1px solid #60A5FA;
}
QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled {
    color: #656565;
    background: #2A2A2D;
    border-color: #3E3E42;
}
QComboBox QAbstractItemView {
    background: #1B1B1C;
    color: #F1F1F1;
    border: 1px solid #434346;
    selection-background-color: #333334;
    selection-color: #FFFFFF;
    outline: 0;
}

QTreeView,
QTableView,
QListView,
QTreeWidget,
QTableWidget {
    background: #1E1E1E;
    color: #DCDCDC;
    alternate-background-color: #252526;
    border: 1px solid #3F3F46;
    gridline-color: #333337;
    selection-background-color: #264F78;
    selection-color: #FFFFFF;
    outline: 0;
}
QTreeView::item,
QTableView::item,
QListView::item {
    padding: 2px 4px;
}
QTreeView::item:hover,
QTableView::item:hover,
QListView::item:hover {
    background: #2A2A2D;
}
QTreeView::item:selected,
QTableView::item:selected,
QListView::item:selected {
    background: #264F78;
    color: #FFFFFF;
}

QHeaderView {
    background: #252526;
}
QHeaderView::section {
    background: #252526;
    color: #DCDCDC;
    padding: 5px 8px;
    border: none;
    border-right: 1px solid #333337;
    border-bottom: 1px solid #333337;
    font-weight: 600;
}
QHeaderView::section:last {
    border-right: none;
}
QTableCornerButton::section {
    background: #252526;
    border: none;
    border-bottom: 1px solid #333337;
}

QCheckBox,
QRadioButton {
    spacing: 6px;
    background: transparent;
}
QCheckBox::indicator,
QTreeView::indicator,
QTableView::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #555555;
    border-radius: 3px;
    background: #333337;
}
QCheckBox::indicator:hover,
QTreeView::indicator:hover,
QTableView::indicator:hover {
    border-color: #60A5FA;
}
QCheckBox::indicator:checked,
QTreeView::indicator:checked,
QTableView::indicator:checked {
    background: #007ACC;
    border: 1px solid #007ACC;
    image: url(:/assets/icons/checkmark-white.svg);
}
QCheckBox::indicator:indeterminate,
QTreeView::indicator:indeterminate {
    background: #264F78;
    border: 1px solid #007ACC;
}
QCheckBox::indicator:disabled,
QTreeView::indicator:disabled {
    background: #2A2A2D;
    border-color: #3E3E42;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #555555;
    border-radius: 7px;
    background: #333337;
}
QRadioButton::indicator:checked {
    border: 4px solid #007ACC;
    background: #1E1E1E;
}
QRadioButton::indicator:disabled {
    border-color: #3E3E42;
    background: #2A2A2D;
}

QGroupBox {
    background: transparent;
    border: 1px solid #3F3F46;
    border-radius: 6px;
    margin-top: 10px;
    padding: 12px 10px 10px 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #DCDCDC;
    font-weight: 600;
}

QProgressBar {
    background: #252526;
    border: 1px solid #434346;
    border-radius: 4px;
    text-align: center;
    color: #DCDCDC;
    min-height: 10px;
}
QProgressBar::chunk {
    background: #007ACC;
    border-radius: 3px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3E3E42;
    min-height: 24px;
    border-radius: 3px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #007ACC;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #3E3E42;
    min-width: 24px;
    border-radius: 3px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #007ACC;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    height: 0;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

QToolTip {
    color: #F0F0F0;
    background: #303034;
    border: 1px solid #5A5A60;
    padding: 4px 8px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #3E3E42;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #007ACC;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #DCDCDC;
    border: 2px solid #007ACC;
    width: 12px;
    height: 12px;
    margin: -6px 0;
    border-radius: 7px;
}
